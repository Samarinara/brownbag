{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "App.tsx",
    "index.ts",
    "app",
    "shared",
    "server",
    "api",
    "scripts",
    "tests"
  ],
  "exclude": ["legacy", "node_modules"]
}
