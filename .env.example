OAUTH_ENCRYPTION_KEY=CHANGE_ME_OAUTH_ENCRYPTION_KEY
OAUTH_PRIVATE_KEY_JWK={"kty":"EC","x":"TFd1x1-utViVYnsYR1r6wNyfb8q3rUd_gGMIhonHoyw","y":"Nu681CQfRv6jdxPBl8guh9F-aXHhIAQNNfY-zvupX6U","crv":"P-256","d":"CHANGE_ME_PRIVATE_KEY_D","kid":"be00d3f36315671ded9df269","alg":"ES256","use":"sig"}

# Run the worker separately from Vercel functions.
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe