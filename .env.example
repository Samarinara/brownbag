# Use 127.0.0.1 (not localhost) for AT OAuth development callbacks.
APP_ORIGIN=http://pokeball:3000
PORT=3000
# Neon pooled connection string from the dashboard. Keep sslmode=require.
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME_DB_PASSWORD@ep-blue-brook-b4msbio0-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
