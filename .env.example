# Use 127.0.0.1 (not localhost) for AT OAuth development callbacks.
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
# Neon pooled connection string from the dashboard. Keep sslmode=require.
DATABASE_URL=
# Optional direct connection for migrations.
DATABASE_URL_UNPOOLED=
# Generate once with npm run keys:generate. Share stable keys across instances.
OAUTH_ENCRYPTION_KEY=
# Production HTTPS requires a private ES256 JSON JWK. Never expose to the browser.
OAUTH_PRIVATE_KEY_JWK=
# Run the worker separately from Vercel functions.
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
