# Public URL used by the browser (also validates request origins).
APP_ORIGIN=http://localhost:3000
PORT=3000
# Published localhost port for Docker/Podman Compose (container always uses 3000).
HOST_PORT=3000
DATABASE_PATH=./data/brownbag.sqlite

# Required for production. Without SMTP, npm run dev logs codes locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Require STARTTLS when SMTP_SECURE=false. Disable only for a trusted local relay.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Use a sender address authorized by your SMTP provider.
SMTP_FROM=

# Set ONLY when behind a trusted reverse proxy; number of proxy hops.
# TRUST_PROXY_HOPS=1
