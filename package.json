{
  "name": "brownbag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild server/indexer.ts server/migrate.ts server/prune-meal-plans.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "email:check": "tsx server/check-mail.ts",
    "db:migrate": "tsx server/migrate.ts",
    "planner:prune": "tsx server/prune-meal-plans.ts",
    "keys:generate": "tsx scripts/generate-oauth-keys.ts",
    "indexer": "tsx server/indexer.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node scripts/generate-icons.mjs",
    "android:debug": "node scripts/android-build.mjs debug",
    "android:unsigned": "node scripts/android-build.mjs unsigned",
    "android:assetlinks": "node scripts/android-assetlinks.mjs"
  },
  "dependencies": {
    "@atproto-labs/fetch-node": "^0.4.0",
    "@atproto/api": "^0.20.44",
    "@atproto/common-web": "^0.5.12",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/lexicon": "^0.7.14",
    "@atproto/oauth-client-node": "^0.5.7",
    "@atproto/syntax": "^0.7.6",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fuse.js": "^7.1.0",
    "helmet": "^8.1.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.577.0",
    "nodemailer": "^10.0.3",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
