{
  "name": "brownbag",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "workspaces": [
    "vendor/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run check && expo export --platform web",
    "export": "expo export --platform all",
    "build:apk": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "dev:api": "node --watch --import tsx server/dev.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "format": "prettier --write app server shared scripts tests App.tsx index.ts playwright.config.ts *.json .github/workflows",
    "format:check": "prettier --check app server shared scripts tests App.tsx index.ts playwright.config.ts *.json .github/workflows",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@atproto-labs/fetch-node": "^0.4.0",
    "@expo/metro-runtime": "~58.0.14",
    "@polli/platform-client": "file:vendor/platform-client",
    "@polli/platform-server": "file:vendor/platform-server",
    "@samarinara/polli-ui": "file:vendor/polli-ui",
    "@workos-inc/authkit-js": "^0.20.5",
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "expo": "~58.0.21",
    "expo-auth-session": "~58.0.17",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-react-native": "^1.61.0",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "~19.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
